{
  "manifest_version": 3,
  "name": "知流",
  "description": "本地优先的实时视频学习助手",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "offscreen",
    "sidePanel",
    "storage",
    "tabCapture",
    "tabs"
  ],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "开始使用知流"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/*",
        "*://*.youtube.com/*",
        "*://youtube.com/*",
        "*://*.douyin.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

