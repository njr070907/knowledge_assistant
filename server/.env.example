# 实时语音识别
ZHILIU_ASR_MODEL=small
ZHILIU_ASR_DEVICE=cpu
ZHILIU_ASR_COMPUTE_TYPE=int8
ZHILIU_CPU_THREADS=8
ZHILIU_TOPIC_SECONDS=36

# 可选：本机 llama.cpp server（OpenAI 兼容接口）
ZHILIU_LLM_ENABLED=false
ZHILIU_LLM_BASE_URL=http://127.0.0.1:8080/v1
ZHILIU_LLM_MODEL=local-model
ZHILIU_LLM_TIMEOUT=120

# 可选：Notion。令牌只保存在本机，不要提交 .env。
NOTION_TOKEN=
NOTION_PARENT_PAGE_ID=
NOTION_API_VERSION=2026-03-11

